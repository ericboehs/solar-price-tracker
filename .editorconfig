root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.enc]
insert_final_newline = false

[Makefile]
indent_style = tab

[config/*.key]
insert_final_newline = unset

[app/assets/builds/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
