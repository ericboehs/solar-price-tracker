<div class="text-center py-12">
  <div class="mx-auto max-w-md">
    <%= icon_svg %>

    <h3 class="mt-4 text-sm font-semibold text-gray-900 dark:text-white">
      <%= title %>
    </h3>

    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
      <%= description %>
    </p>

    <% if actions.present? %>
      <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center">
        <% actions.each do |action| %>
          <%= link_to action[:text], action[:path],
              class: "inline-flex items-center rounded-md bg-orange-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-orange-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600 transition-colors" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
