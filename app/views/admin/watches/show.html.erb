<div class="bg-white dark:bg-gray-900 py-6">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <nav class="flex" aria-label="Breadcrumb">
        <ol role="list" class="flex items-center space-x-4">
          <li>
            <%= link_to admin_watches_path, class: "text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300" do %>
              Watches
            <% end %>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="h-5 w-5 flex-shrink-0 text-gray-300 dark:text-gray-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M5.555 17.776l8-16 .894.448-8 16-.894-.448z" />
              </svg>
              <span class="ml-4 text-sm font-medium text-gray-900 dark:text-white" aria-current="page"><%= @watch.display_name %></span>
            </div>
          </li>
        </ol>
      </nav>

      <div class="mt-4 flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold leading-7 text-gray-900 dark:text-white sm:truncate sm:text-3xl">
            <%= @watch.display_name %>
          </h1>
          <div class="mt-2 flex items-center space-x-4">
            <% status_colors = {
              'active' => 'bg-green-50 dark:bg-green-900/20 text-green-800 dark:text-green-300 ring-green-600/20 dark:ring-green-400/30',
              'inactive' => 'bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300 ring-gray-500/10 dark:ring-gray-400/20',
              'ready' => 'bg-yellow-50 dark:bg-yellow-900/20 text-yellow-800 dark:text-yellow-300 ring-yellow-600/20 dark:ring-yellow-400/30',
              'recently_scraped' => 'bg-blue-50 dark:bg-blue-900/20 text-blue-800 dark:text-blue-300 ring-blue-600/20 dark:ring-blue-400/30',
              'scheduled' => 'bg-purple-50 dark:bg-purple-900/20 text-purple-800 dark:text-purple-300 ring-purple-600/20 dark:ring-purple-400/30'
            } %>
            <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset <%= status_colors[@watch.status] %>">
              <%= @watch.status.humanize %>
            </span>
            <span class="inline-flex items-center rounded-md bg-gray-50 dark:bg-gray-800 px-2 py-1 text-xs font-medium text-gray-600 dark:text-gray-300 ring-1 ring-inset ring-gray-500/10 dark:ring-gray-400/20">
              <%= @watch.watch_type.titleize %>
            </span>
          </div>
        </div>
        <div class="flex space-x-3">
          <% if @watch.active? %>
            <%= link_to "Scrape Now", admin_scrape_watch_path(@watch),
                data: { turbo_method: :post },
                class: "inline-flex items-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600" %>
          <% end %>
          <%= link_to "Edit", edit_admin_watch_path(@watch),
              class: "inline-flex items-center rounded-md bg-orange-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-orange-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600" %>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <!-- Watch Details -->
      <div class="lg:col-span-2">
        <div class="bg-white dark:bg-gray-800 shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h3 class="text-lg font-medium leading-6 text-gray-900 dark:text-white">Watch Details</h3>
            <div class="mt-5 border-t border-gray-200 dark:border-gray-700">
              <dl class="divide-y divide-gray-200 dark:divide-gray-700">
                <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:py-5">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Name</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:col-span-2 sm:mt-0">
                    <%= @watch.name %>
                  </dd>
                </div>
                <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:py-5">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">URL</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:col-span-2 sm:mt-0 break-all">
                    <% if safe_url(@watch.url) %>
                      <%= link_to safe_url(@watch.url), safe_url(@watch.url), target: "_blank", rel: "noopener noreferrer",
                          class: "text-orange-600 dark:text-orange-400 hover:text-orange-500 dark:hover:text-orange-300" %>
                    <% else %>
                      <span class="text-gray-500 dark:text-gray-400">Invalid URL</span>
                    <% end %>
                  </dd>
                </div>
                <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:py-5">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Type</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:col-span-2 sm:mt-0">
                    <%= @watch.watch_type.titleize %>
                  </dd>
                </div>
                <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:py-5">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Status</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:col-span-2 sm:mt-0">
                    <%= @watch.active? ? "Active" : "Inactive" %>
                  </dd>
                </div>
                <% if @watch.description.present? %>
                  <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:py-5">
                    <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Description</dt>
                    <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:col-span-2 sm:mt-0">
                      <%= simple_format(@watch.description) %>
                    </dd>
                  </div>
                <% end %>
                <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:py-5">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Exclude Bundles</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:col-span-2 sm:mt-0">
                    <%= @watch.exclude_bundles? ? "Yes" : "No" %>
                  </dd>
                </div>
                <% if @watch.omit_terms.present? %>
                  <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:py-5">
                    <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Omit Terms</dt>
                    <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:col-span-2 sm:mt-0">
                      <div class="flex flex-wrap gap-1">
                        <% @watch.omit_terms_array.each do |term| %>
                          <span class="inline-flex items-center rounded-md bg-red-50 dark:bg-red-900/30 px-2 py-1 text-xs font-medium text-red-700 dark:text-red-300 ring-1 ring-inset ring-red-600/10 dark:ring-red-400/30">
                            <%= term %>
                          </span>
                        <% end %>
                      </div>
                    </dd>
                  </div>
                <% end %>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Statistics -->
      <div class="space-y-6">
        <!-- Scraping Stats -->
        <div class="bg-white dark:bg-gray-800 shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h3 class="text-lg font-medium leading-6 text-gray-900 dark:text-white">Scraping Statistics</h3>
            <div class="mt-5">
              <div class="grid grid-cols-1 gap-5">
                <div>
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Products Found</dt>
                  <dd class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white">
                    <%= @watch.products_found %>
                  </dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Scrape Count</dt>
                  <dd class="mt-1 text-2xl font-semibold text-gray-900 dark:text-white">
                    <%= @watch.scrape_count %>
                  </dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Frequency</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white">
                    Every <%= @watch.scrape_frequency_hours %> hours
                  </dd>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Timing Info -->
        <div class="bg-white dark:bg-gray-800 shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h3 class="text-lg font-medium leading-6 text-gray-900 dark:text-white">Timing</h3>
            <div class="mt-5">
              <div class="space-y-4">
                <div>
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Created</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white">
                    <%= @watch.created_at.strftime("%B %d, %Y at %I:%M %p") %>
                  </dd>
                </div>
                <% if @watch.last_scraped_at %>
                  <div>
                    <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Last Scraped</dt>
                    <dd class="mt-1 text-sm text-gray-900 dark:text-white">
                      <%= time_ago_in_words(@watch.last_scraped_at) %> ago
                      <br>
                      <span class="text-xs text-gray-500 dark:text-gray-400">
                        <%= @watch.last_scraped_at.strftime("%B %d, %Y at %I:%M %p") %>
                      </span>
                    </dd>
                  </div>
                <% end %>
                <% if @watch.next_scrape_at %>
                  <div>
                    <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Next Scrape</dt>
                    <dd class="mt-1 text-sm text-gray-900 dark:text-white">
                      <% if @watch.next_scrape_at <= Time.current %>
                        <span class="text-green-600 dark:text-green-400 font-medium">Ready now</span>
                      <% else %>
                        In <%= time_ago_in_words(@watch.next_scrape_at) %>
                        <br>
                        <span class="text-xs text-gray-500 dark:text-gray-400">
                          <%= @watch.next_scrape_at.strftime("%B %d, %Y at %I:%M %p") %>
                        </span>
                      <% end %>
                    </dd>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="bg-white dark:bg-gray-800 shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h3 class="text-lg font-medium leading-6 text-gray-900 dark:text-white">Quick Actions</h3>
            <div class="mt-5 space-y-3">
              <%= link_to edit_admin_watch_path(@watch),
                  class: "block w-full rounded-md bg-orange-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-orange-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600" do %>
                Edit Watch
              <% end %>
              <% if @watch.active? %>
                <%= link_to admin_scrape_watch_path(@watch),
                    data: { turbo_method: :post },
                    class: "block w-full rounded-md bg-green-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-green-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600" do %>
                  Trigger Scrape
                <% end %>
              <% end %>
              <%= link_to admin_watch_path(@watch),
                  data: { turbo_method: :delete, confirm: "Are you sure you want to delete this watch? This action cannot be undone." },
                  class: "block w-full rounded-md bg-red-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-red-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600" do %>
                Delete Watch
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
