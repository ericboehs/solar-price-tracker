<div class="bg-white dark:bg-gray-900 py-6">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <nav class="flex" aria-label="Breadcrumb">
        <ol role="list" class="flex items-center space-x-4">
          <li>
            <%= link_to admin_watches_path, class: "text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300" do %>
              Watches
            <% end %>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="h-5 w-5 flex-shrink-0 text-gray-300 dark:text-gray-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M5.555 17.776l8-16 .894.448-8 16-.894-.448z" />
              </svg>
              <span class="ml-4 text-sm font-medium text-gray-900 dark:text-white" aria-current="page">New Watch</span>
            </div>
          </li>
        </ol>
      </nav>

      <div class="mt-4">
        <h1 class="text-2xl font-bold leading-7 text-gray-900 dark:text-white sm:truncate sm:text-3xl">
          Create New Watch
        </h1>
        <p class="mt-2 text-sm text-gray-700 dark:text-gray-300">
          Set up automated monitoring for URLs to track new products and price changes.
        </p>
      </div>
    </div>

    <!-- Form -->
    <%= form_with model: [:admin, @watch], local: true, class: "space-y-8" do |form| %>
      <!-- Error messages -->
      <% if @watch.errors.any? %>
        <div class="rounded-md bg-red-50 dark:bg-red-900/20 p-4 border border-red-200 dark:border-red-800">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-red-800 dark:text-red-200">
                Please fix the following errors:
              </h3>
              <div class="mt-2 text-sm text-red-700 dark:text-red-300">
                <ul role="list" class="list-disc space-y-1 pl-5">
                  <% @watch.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Form fields - Tailwind Plus inspired -->
      <div class="mx-auto max-w-3xl">
        <div class="bg-white dark:bg-gray-900 shadow-xl ring-1 ring-gray-900/5 dark:ring-white/10 sm:rounded-xl">
          <div class="px-8 py-10 sm:px-10">
            <div class="mb-8">
              <h2 class="text-lg font-semibold leading-7 text-gray-900 dark:text-white">
                Watch Configuration
              </h2>
              <p class="mt-1 text-sm leading-6 text-gray-500 dark:text-gray-400">
                Set up automated monitoring for URLs to track new products and price changes.
              </p>
            </div>

            <div class="space-y-8">
              <!-- Basic Information -->
              <div class="border-b border-gray-200 dark:border-gray-800 pb-8">
                <h3 class="text-base font-semibold leading-7 text-gray-900 dark:text-white">Basic Information</h3>
                <p class="mt-1 text-sm leading-6 text-gray-500 dark:text-gray-400">
                  Name and URL for this watch configuration.
                </p>

                <div class="mt-6 grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-6">
                  <!-- Name -->
                  <div class="sm:col-span-4">
                    <%= form.label :name, class: "block text-sm font-medium leading-6 text-gray-900 dark:text-white" do %>
                      Watch name <span class="text-red-500">*</span>
                    <% end %>
                    <div class="mt-2">
                      <%= form.text_field :name,
                          class: "block w-full rounded-md border-0 px-3.5 py-2 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 dark:bg-gray-800 placeholder:text-gray-400 dark:placeholder:text-gray-500 focus:ring-2 focus:ring-inset focus:ring-orange-600 dark:focus:ring-orange-400 sm:text-sm sm:leading-6 transition-colors",
                          placeholder: "EG4 Batteries Search" %>
                    </div>
                    <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">A descriptive name to identify this watch.</p>
                  </div>

                  <!-- URL -->
                  <div class="sm:col-span-6">
                    <%= form.label :url, class: "block text-sm font-medium leading-6 text-gray-900 dark:text-white" do %>
                      Target URL <span class="text-red-500">*</span>
                    <% end %>
                    <div class="mt-2">
                      <%= form.url_field :url,
                          class: "block w-full rounded-md border-0 px-3.5 py-2 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 dark:bg-gray-800 placeholder:text-gray-400 dark:placeholder:text-gray-500 focus:ring-2 focus:ring-inset focus:ring-orange-600 dark:focus:ring-orange-400 sm:text-sm sm:leading-6 transition-colors",
                          placeholder: "https://signaturesolar.com/search?q=eg4" %>
                    </div>
                    <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">The complete URL to monitor for product changes.</p>
                  </div>
                </div>
              </div>

              <!-- Configuration -->
              <div class="border-b border-gray-200 dark:border-gray-800 pb-8">
                <h3 class="text-base font-semibold leading-7 text-gray-900 dark:text-white">Configuration</h3>
                <p class="mt-1 text-sm leading-6 text-gray-500 dark:text-gray-400">
                  Configure how this watch should operate.
                </p>

                <div class="mt-6 space-y-6">
                  <div class="grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-6">
                    <!-- Watch Type -->
                    <div class="sm:col-span-3">
                      <%= form.label :watch_type, "Page type", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-white" %>
                      <div class="mt-2">
                        <%= form.select :watch_type,
                            options_for_select([
                              ['Search results page', 'search'],
                              ['Individual product page', 'product'],
                              ['Category listing page', 'category']
                            ], @watch.watch_type),
                            { prompt: 'Select page type...' },
                            class: "block w-full rounded-md border-0 px-3.5 py-2 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 dark:bg-gray-800 focus:ring-2 focus:ring-inset focus:ring-orange-600 dark:focus:ring-orange-400 sm:text-sm sm:leading-6 transition-colors" %>
                      </div>
                      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">Type of page being monitored.</p>
                    </div>
                  </div>

                  <!-- Options -->
                  <fieldset>
                    <legend class="text-sm font-medium leading-6 text-gray-900 dark:text-white">Options</legend>
                    <div class="mt-4 space-y-4">
                      <div class="flex items-start">
                        <div class="flex h-6 items-center">
                          <%= form.check_box :active,
                              checked: @watch.active?,
                              class: "h-4 w-4 rounded border-gray-300 dark:border-gray-600 text-orange-600 focus:ring-orange-600 dark:focus:ring-orange-400 dark:bg-gray-800" %>
                        </div>
                        <div class="ml-3 text-sm leading-6">
                          <%= form.label :active, "Enable monitoring", class: "font-medium text-gray-900 dark:text-white" %>
                          <p class="text-gray-500 dark:text-gray-400">Automatically scrape this URL for changes.</p>
                        </div>
                      </div>

                      <div class="flex items-start">
                        <div class="flex h-6 items-center">
                          <%= form.check_box :exclude_bundles,
                              checked: @watch.exclude_bundles?,
                              class: "h-4 w-4 rounded border-gray-300 dark:border-gray-600 text-orange-600 focus:ring-orange-600 dark:focus:ring-orange-400 dark:bg-gray-800" %>
                        </div>
                        <div class="ml-3 text-sm leading-6">
                          <%= form.label :exclude_bundles, "Exclude bundles", class: "font-medium text-gray-900 dark:text-white" %>
                          <p class="text-gray-500 dark:text-gray-400">Skip products that appear to be bundles or kits.</p>
                        </div>
                      </div>
                    </div>
                  </fieldset>
                </div>
              </div>

              <!-- Additional Details -->
              <div>
                <h3 class="text-base font-semibold leading-7 text-gray-900 dark:text-white">Additional Details</h3>
                <p class="mt-1 text-sm leading-6 text-gray-500 dark:text-gray-400">
                  Optional configuration for more precise monitoring.
                </p>

                <div class="mt-6 space-y-6">
                  <!-- Description -->
                  <div>
                    <%= form.label :description, "Description", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-white" %>
                    <div class="mt-2">
                      <%= form.text_area :description,
                          rows: 3,
                          class: "block w-full rounded-md border-0 px-3.5 py-2 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 dark:bg-gray-800 placeholder:text-gray-400 dark:placeholder:text-gray-500 focus:ring-2 focus:ring-inset focus:ring-orange-600 dark:focus:ring-orange-400 sm:text-sm sm:leading-6 transition-colors",
                          placeholder: "Brief description of what this watch monitors..." %>
                    </div>
                    <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">Optional description for your reference.</p>
                  </div>

                  <!-- Omit Terms -->
                  <div>
                    <%= form.label :omit_terms, "Exclusion terms", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-white" %>
                    <div class="mt-2">
                      <%= form.text_area :omit_terms,
                          rows: 2,
                          class: "block w-full rounded-md border-0 px-3.5 py-2 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 dark:bg-gray-800 placeholder:text-gray-400 dark:placeholder:text-gray-500 focus:ring-2 focus:ring-inset focus:ring-orange-600 dark:focus:ring-orange-400 sm:text-sm sm:leading-6 transition-colors",
                          placeholder: "bundle, kit, refurbished" %>
                    </div>
                    <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">Comma-separated terms. Products containing these will be excluded.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="flex justify-end space-x-3">
        <%= link_to "Cancel", admin_watches_path,
            class: "rounded-md bg-white dark:bg-gray-800 px-3 py-2 text-sm font-semibold text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 hover:bg-gray-50 dark:hover:bg-gray-700" %>
        <%= form.submit "Create Watch",
            class: "rounded-md bg-orange-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-orange-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-600" %>
      </div>
    <% end %>
  </div>
</div>
